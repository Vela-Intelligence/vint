{
  "name": "vint",
  "version": "0.8.0",
  "private": true,
  "description": "AI-native vanilla TypeScript UI framework: real DOM, VanJS-shaped tag functions, Solid-faithful reactivity",
  "type": "module",
  "main": "./dist/vint.js",
  "types": "./dist/vint.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "docs/llms.txt",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/vint.d.ts",
      "development": "./dist/vint.js",
      "production": "./dist/vint.prod.js",
      "default": "./dist/vint.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vela-Intelligence/vint.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "build": "npm run build:dev && npm run build:prod && npm run build:types",
    "build:dev": "esbuild src/index.ts --bundle --format=esm \"--banner:js=/* vint $npm_package_version — MIT License, Copyright (c) 2026 Robert Salesas. https://github.com/Vela-Intelligence/vint */\" --define:__VINT_DEV__=true --outfile=dist/vint.js",
    "build:prod": "node scripts/build-prod.mjs",
    "build:types": "tsc -p tsconfig.build.json && dts-bundle-generator -o dist/vint.d.ts src/index.ts --project tsconfig.build.json",
    "prepare": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "check:alignment": "node scripts/check-alignment.mjs",
    "examples": "esbuild examples/main.ts --bundle --format=esm --outfile=examples/dist/main.js --servedir=examples --watch",
    "bench": "esbuild examples/bench.ts --bundle --format=esm --outfile=examples/dist/bench.js --servedir=examples",
    "virtual": "esbuild examples/virtual.ts --bundle --format=esm --outfile=examples/dist/virtual.js --servedir=examples --serve=8002"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.23.0",
    "happy-dom": "^15.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
