{
  "name": "vint",
  "version": "0.8.0",
  "private": true,
  "description": "AI-native vanilla TypeScript UI framework: real DOM, VanJS-shaped tag functions, Solid-faithful reactivity",
  "type": "module",
  "main": "./dist/vint.js",
  "types": "./dist/vint.d.ts",
  "bin": {
    "vint": "bin/verify.mjs"
  },
  "sideEffects": false,
  "files": [
    "dist/vint.js",
    "dist/vint.prod.js",
    "dist/vint.d.ts",
    "dist/vint-testing.js",
    "dist/vint-testing.pkg.js",
    "dist/vint-testing.d.ts",
    "bin/verify.mjs",
    "docs/llms.txt",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/vint.d.ts",
      "development": "./dist/vint.js",
      "production": "./dist/vint.prod.js",
      "default": "./dist/vint.js"
    },
    "./package.json": "./package.json",
    "./testing": {
      "types": "./dist/vint-testing.d.ts",
      "default": "./dist/vint-testing.pkg.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vela-Intelligence/vint.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:seeds": "for s in 20260904 777 31337; do VINT_SEED=$s vitest run tests/reactive.property.test.ts tests/control.for.fuzz.test.ts tests/dom.range.fuzz.test.ts || exit 1; done",
    "test:long": "VINT_RUNS=2500 vitest run tests/reactive.property.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "build": "npm run build:dev && npm run build:prod && npm run build:testing && npm run build:types",
    "build:dev": "esbuild src/index.ts --bundle --format=esm \"--banner:js=/* vint $npm_package_version — MIT License, Copyright (c) 2026 Robert Salesas. https://github.com/Vela-Intelligence/vint */\" --define:__VINT_DEV__=true --outfile=dist/vint.js",
    "build:prod": "node scripts/build-prod.mjs",
    "build:types": "tsc -p tsconfig.build.json && dts-bundle-generator -o dist/vint.d.ts src/index.ts --project tsconfig.build.json && dts-bundle-generator -o dist/vint-testing.d.ts src/testing.ts --project tsconfig.build.json",
    "prepare": "npm run build",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke-testing.mjs",
    "mutate": "stryker run",
    "check:alignment": "node scripts/check-alignment.mjs",
    "gen:props": "node scripts/gen-props.mjs",
    "check:props": "node scripts/gen-props.mjs --check",
    "examples": "esbuild examples/main.ts --bundle --format=esm --outfile=examples/dist/main.js --servedir=examples --watch",
    "bench": "esbuild examples/bench.ts --bundle --format=esm --outfile=examples/dist/bench.js --servedir=examples",
    "virtual": "esbuild examples/virtual.ts --bundle --format=esm --outfile=examples/dist/virtual.js --servedir=examples --serve=8002",
    "build:testing": "node scripts/build-testing.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@happy-dom/global-registrator": "^15.11.7",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/browser": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.23.0",
    "fast-check": "^4.9.0",
    "happy-dom": "^15.0.0",
    "playwright": "1.62",
    "solid-js": "^1.9.15",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
